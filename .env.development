# CardIQ Environment Variables - Development

# Application
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002

# Database (PostgreSQL)
DATABASE_URL=postgresql://cardiq_user:cardiq_password@localhost:5432/cardiq
DB_HOST=localhost
DB_PORT=5432
DB_USER=cardiq_user
DB_PASSWORD=cardiq_password
DB_NAME=cardiq

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security
JWT_SECRET=dev_jwt_secret
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=dev_refresh_secret
JWT_REFRESH_EXPIRATION=7d

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vector DB (ChromaDB)
VECTOR_DB_URL=http://localhost:8000
